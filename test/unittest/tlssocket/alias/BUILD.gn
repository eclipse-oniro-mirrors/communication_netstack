import("//build/test.gni")
import("//foundation/communication/netstack/netstack_config.gni")

TLS = "$NETSTACK_NATIVE_ROOT/tls_socket"

ohos_unittest("tls_cert_alias_test") {
  module_out_path = "netstack/netstack/tls_socket_unittest"
  sources = [
    "$TLS/src/socket_error.cpp",
    "$TLS/src/tls_cert_alias.cpp",
    "$TLS/src/tls_cert_manager_adapter.cpp",
    "$TLS/src/tls_cert_manager_provider.cpp",
    "tls_cert_alias_branch_test.cpp",
    "tls_cert_alias_test.cpp",
  ]
  include_dirs = [
    "$TLS/include",
    "$NETSTACK_DIR/utils/log/include",
  ]

  # The provider uses an injected adapter; also exercise the disabled backend.
  defines = [ "NETSTACK_HAS_CERT_MANAGER=0" ]
  external_deps = [
    "hilog:libhilog",
    "openssl:libcrypto_shared",
    "openssl:libssl_shared",
  ]
  part_name = "netstack"
  subsystem_name = "communication"
}

if (defined(global_parts_info) &&
    defined(global_parts_info.security_certificate_manager) &&
    global_parts_info.security_certificate_manager) {
  ohos_unittest("tls_cert_manager_adapter_test") {
    module_out_path = "netstack/netstack/tls_socket_unittest"
    sources = [
      "$TLS/src/tls_cert_manager_adapter.cpp",
      "tls_cert_manager_adapter_test.cpp",
    ]
    include_dirs = [
      "$TLS/include",
      "$NETSTACK_DIR/utils/log/include",
    ]

    # The executable's Cm functions replace the SDK entry points; no service is called.
    defines = [ "NETSTACK_HAS_CERT_MANAGER=1" ]
    external_deps = [
      "certificate_manager:cert_manager_sdk",
      "hilog:libhilog",
      "openssl:libcrypto_shared",
    ]
    part_name = "netstack"
    subsystem_name = "communication"
  }
}
