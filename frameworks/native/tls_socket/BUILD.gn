import("//build/ohos.gni")

ohos_static_library("tls_cert_alias") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [
    "src/tls_cert_alias.cpp",
    "src/tls_cert_manager_adapter.cpp",
    "src/tls_cert_manager_provider.cpp",
  ]
  include_dirs = [
    "include",
    "//foundation/communication/netstack/utils/log/include",
  ]
  external_deps = [
    "hilog:libhilog",
    "openssl:libcrypto_shared",
    "openssl:libssl_shared",
  ]
  if (is_ohos && is_standard_system && product_name != "ohos-sdk" &&
      defined(global_parts_info) &&
      defined(global_parts_info.security_certificate_manager) &&
      global_parts_info.security_certificate_manager) {
    # The SDK reports NOT_SUPPORTED when its credential feature is disabled.
    # Keep certificate manager's private feature configuration within its own part.
    defines = [ "NETSTACK_HAS_CERT_MANAGER=1" ]
    external_deps += [ "certificate_manager:cert_manager_sdk" ]
  } else {
    defines = [ "NETSTACK_HAS_CERT_MANAGER=0" ]
  }
  part_name = "netstack"
  subsystem_name = "communication"
}
